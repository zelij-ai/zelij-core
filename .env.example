# Zelij Core — variables de l'installation. Copier en .env ; jamais commité, jamais partagé.
# Clé Claude du fondateur : chaque appel d'agent est payé sur cette clé, le coût s'affiche dans le bureau.
ANTHROPIC_API_KEY=
# Plafond mensuel en euros : au-delà, aucun agent n'est appelé tant qu'il n'est pas relevé.
PLAFOND_MENSUEL_EUR=50
# Taux dollar → euro utilisé pour afficher les coûts (les tarifs des modèles sont en dollars).
TAUX_USD_EUR=0.92
# Mot de passe de la base PostgreSQL du projet Compose (généré une fois).
CORE_DB_PASSWORD=
# Clé de signature des sessions (cookie). 48 caractères aléatoires au moins. Obligatoire en production.
SECRET_KEY=
# Origine publique du bureau (liens des e-mails, contrôle d'origine des formulaires).
APP_ORIGIN=http://localhost:8000
CORE_PORT=8000
# Nom de domaine du bureau pour la mise en ligne en https avec docker-compose.tls.yml (Caddy, certificat automatique).
CORE_DOMAINE=
# Envoi des liens de connexion. Sans SMTP_HOST, les liens sont seulement journalisés (développement).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=bureau@votre-domaine.fr
# Clé publique Ed25519 (hexadécimal) de l'éditeur des modules : seuls les modules signés par elle s'installent.
# Clé publique de zelij.ai (générée le 08/10/2026) :
ZELIJ_CLE_PUBLIQUE=8da6c92455558c15a1566b333cef22fb5fc60aad9ffbf811f372e4bb7eacc42a
# Modèle forcé pour un agent (facultatif) : MODELE_<ID_EN_MAJUSCULES>, ex. MODELE_CHEF_DE_CABINET=claude-sonnet-5-5

# --- Software factory (lot 5) : le site de l'entreprise, sa cible de déploiement, le domaine.
# Dépôt GitHub du site et jeton restreint à CE dépôt (contents + pull requests). Le Bâtisseur ne fusionne jamais.
SITE_DEPOT=
GITHUB_TOKEN=
# Dossier des pages publiées par l'agent Croissance (ex. /blog/), gabarit du site, domaine public (https://…).
SITE_PREFIXE=/
SITE_GABARIT=_gabarit/page.html
SITE_DOMAINE=
# Cible de déploiement : ssh (serveur Linux) ou ovh (même serveur + domaine et DNS par l'API OVH).
CIBLE=ssh
SSH_HOTE=
SSH_UTILISATEUR=
SSH_PORT=22
# Clé privée SSH montée en lecture seule dans le conteneur (ex. /run/secrets/ssh_cle) ; jamais commitée.
SSH_CLE=
# Clé publique du serveur (facultatif, recommandé) : la ligne que donne `ssh-keyscan -t ed25519 <hôte>` sans le nom d'hôte,
# ex. "ssh-ed25519 AAAA…". Posée, toute autre clé est refusée ; absente, la clé est acceptée au premier contact.
SSH_CLE_HOTE=
# Dossier des versions du site sur le serveur (le lien `courant` pointe la version en ligne).
SITE_DOSSIER=/var/www/site
# API OVH (cible ovh) : clés créées sur https://eu.api.ovh.com/createToken/ avec GET, POST, PUT sur /domain/zone/*.
OVH_ENDPOINT=ovh-eu
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=
# Sauvegardes quotidiennes du bureau (volume).
SAUVEGARDES_DIR=/data/sauvegardes
