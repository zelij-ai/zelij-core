# Zelij Core — variables de l'installation. Copier en .env ; jamais commité, jamais partagé.
# Clé Claude du fondateur : chaque appel d'agent est payé sur cette clé, le coût s'affiche dans le bureau.
ANTHROPIC_API_KEY=
# Plafond mensuel en euros : au-delà, aucun agent n'est appelé tant qu'il n'est pas relevé.
PLAFOND_MENSUEL_EUR=50
# Taux dollar → euro utilisé pour afficher les coûts (les tarifs des modèles sont en dollars).
TAUX_USD_EUR=0.92
# Mot de passe de la base PostgreSQL du projet Compose (généré une fois).
CORE_DB_PASSWORD=
# Clé de signature des sessions (cookie). 48 caractères aléatoires au moins. Obligatoire en production.
SECRET_KEY=
# Origine publique du bureau (liens des e-mails, contrôle d'origine des formulaires).
APP_ORIGIN=http://localhost:8000
CORE_PORT=8000
# Interface sur laquelle le port est publié. Par défaut la machine seulement (127.0.0.1) : l'accès public passe par l'https
# (docker-compose.tls.yml). 0.0.0.0 publie le port en clair sur toutes les interfaces : réseau privé de confiance uniquement.
CORE_ECOUTE=127.0.0.1
# Adresse du fondateur (facultatif, recommandé si le bureau est joignable avant votre première connexion) : posée, seule
# cette adresse peut créer l'organisation. Une installation porte une seule organisation ; ensuite aucune adresse inconnue n'entre.
FONDATEUR_EMAIL=
# Derrière votre propre serveur TLS (Nginx, Traefik…) seulement : adresses dont les en-têtes X-Forwarded-* sont crus (* = toutes).
# Laissez vide sinon ; docker-compose.tls.yml le règle lui-même pour Caddy.
#FORWARDED_ALLOW_IPS=
# Nom de domaine du bureau pour la mise en ligne en https avec docker-compose.tls.yml (Caddy, certificat automatique).
CORE_DOMAINE=
# Envoi des liens de connexion. Sans SMTP_HOST, les liens sont seulement journalisés (développement).
# Le certificat du serveur de messagerie est vérifié : STARTTLS sur le port 587, TLS direct sur le port 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=bureau@votre-domaine.fr
# --- Dans la poche : décider depuis le téléphone (facultatif).
# Par e-mail : dès que SMTP_HOST est renseigné, chaque décision arrive avec deux liens signés à usage unique. 0 pour couper.
DECISIONS_PAR_EMAIL=1
# Par Telegram : un robot créé auprès de @BotFather (jeton), et l'identifiant de VOTRE conversation avec lui (un nombre).
# Seule cette conversation peut presser les boutons ; tout autre clic est refusé et journalisé. Guide : docs/MODE-D-EMPLOI.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Clé publique Ed25519 (hexadécimal) de l'éditeur des modules : seuls les modules signés par elle s'installent.
# Clé publique de zelij.ai (générée le 08/10/2026) :
ZELIJ_CLE_PUBLIQUE=8da6c92455558c15a1566b333cef22fb5fc60aad9ffbf811f372e4bb7eacc42a
# Modèle forcé pour un agent (facultatif) : MODELE_<ID_EN_MAJUSCULES>, ex. MODELE_CHEF_DE_CABINET=claude-sonnet-5-5

# --- Autre fournisseur de modèle (facultatif). Par défaut : Claude, avec ANTHROPIC_API_KEY ci-dessus.
# « openai » = toute interface compatible avec celle d'OpenAI : OpenAI, un modèle local (Ollama, LM Studio), Mistral, OpenRouter…
# Vos demandes et ce que lisent les agents partent chez ce fournisseur ; avec un modèle local, rien ne quitte la machine.
#MODELE_FOURNISSEUR=openai
#OPENAI_API_KEY=
# Adresse de l'interface. Vide = OpenAI. Ollama dans Docker : http://host.docker.internal:11434/v1
#OPENAI_BASE_URL=
# Le nom des modèles, par classe d'agent (obligatoire avec un autre fournisseur : les noms par défaut sont ceux de Claude).
#MODELE_RAISONNEMENT=
#MODELE_EQUILIBRE=
#MODELE_RAPIDE=
# Leurs tarifs en dollars par million de tokens : {"nom": [entrée, sortie, lecture de cache]}. Un modèle local : [0, 0, 0].
# Sans déclaration, le coût est compté au tarif le plus cher de la table, pour ne jamais afficher zéro par oubli.
#MODELE_TARIFS={"nom-du-modele": [0, 0, 0]}

# --- Software factory (lot 5) : le site de l'entreprise, sa cible de déploiement, le domaine.
# Dépôt GitHub du site et jeton restreint à CE dépôt (contents + pull requests). Le Bâtisseur ne fusionne jamais.
SITE_DEPOT=
GITHUB_TOKEN=
# Dossier des pages publiées par l'agent Croissance (ex. /blog/), gabarit du site, domaine public (https://…).
SITE_PREFIXE=/
SITE_GABARIT=_gabarit/page.html
SITE_DOMAINE=
# Cible de déploiement : ssh (serveur Linux) ou ovh (même serveur + domaine et DNS par l'API OVH).
CIBLE=ssh
SSH_HOTE=
SSH_UTILISATEUR=
SSH_PORT=22
# Clé privée SSH montée en lecture seule dans le conteneur (ex. /run/secrets/ssh_cle) ; jamais commitée.
SSH_CLE=
# Clé publique du serveur (facultatif, recommandé) : la ligne que donne `ssh-keyscan -t ed25519 <hôte>` sans le nom d'hôte,
# ex. "ssh-ed25519 AAAA…". Posée, toute autre clé est refusée ; absente, la clé est acceptée au premier contact.
SSH_CLE_HOTE=
# Dossier des versions du site sur le serveur (le lien `courant` pointe la version en ligne).
SITE_DOSSIER=/var/www/site
# API OVH (cible ovh) : clés créées sur https://eu.api.ovh.com/createToken/ avec GET, POST, PUT sur /domain/zone/*.
OVH_ENDPOINT=ovh-eu
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=
# Sauvegardes quotidiennes du bureau (volume).
SAUVEGARDES_DIR=/data/sauvegardes

# --- Finances et publication (facultatif).
# Clé Stripe restreinte, en lecture seule sur les paiements : import des ventes confirmées dans la page Finances.
STRIPE_SECRET_KEY=
# Site WordPress (à défaut de dépôt GitHub) : les pages rédigées y arrivent en brouillon. Compte auteur et mot de passe d'application.
WP_URL=
WP_USER=
WP_APP_PASSWORD=
