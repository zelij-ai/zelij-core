# Zelij Core derrière Caddy : certificat automatique pour {$CORE_DOMAINE}, http redirigé vers https,
# le bureau n'est joignable que par ici. Les en-têtes de sécurité sont posés par le bureau lui-même.
{$CORE_DOMAINE} {
	encode zstd gzip
	reverse_proxy core-app:8000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
	}
}
